# Copy to .env.local for local development. Never commit real secrets.
# Default mode is mock; no paid AI requests are made.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_REQUEST_COST_TWD=0
AI_INPUT_COST_PER_MILLION_TWD=0
AI_OUTPUT_COST_PER_MILLION_TWD=0
AI_TIMEOUT_MS=30000

# Supabase browser-safe values (project URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
AUTH_SECRET=
GCAN_GITHUB_REPOSITORY=X84657465/global-citizen-ai-network
GCAN_GITHUB_READ_TOKEN=

NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP=false
ENABLE_PUBLIC_SIGNUP=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
