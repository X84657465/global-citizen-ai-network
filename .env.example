# Copy to .env.local for local development. Never commit real secrets.
# Default mode is mock; no paid AI requests are made.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_SPEND_LIMIT_TWD=0

# Supabase browser-safe values (public project URL and anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
AUTH_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
